# Copy this file to .env.local and replace the placeholder values.
# The public/publishable key is designed for browser use.
# Never place a Supabase service-role key in this project.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
ENABLE_DEMO_MODE=false
# Public signup remains disabled unless deliberately enabled for testing.
ENABLE_PUBLIC_SIGNUP=false
# Server-only. Required for trusted writes and school enquiry inserts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Server-only. Set this in .env.local only to receive private enquiry emails.
ENQUIRY_NOTIFICATION_EMAIL=your_private_inbox@example.com
# Server-only. Set this in .env.local when using a transactional provider such as Resend.
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_KEY
# Verified sender for transactional email.
EMAIL_FROM=Hardware Learning Lab <enquiries@YOUR_VERIFIED_DOMAIN>
