# Copy this file to .env.local. Never commit real values.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix these values with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
RATE_LIMIT_SALT=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ENQUIRY_NOTIFICATION_EMAIL=your_private_inbox@example.com
RESEND_API_KEY=YOUR_SERVER_ONLY_RESEND_KEY
EMAIL_FROM=Hardware Learning Lab <enquiries@YOUR_VERIFIED_DOMAIN>

# HLL's own model server. No OpenAI/Anthropic/Google account is required.
# Enable only after a model is installed and the acceptance review is complete.
HLL_TUTOR_ENABLED=false
HLL_TUTOR_BASE_URL=http://127.0.0.1:11434/v1/
HLL_TUTOR_MODEL=qwen3-vl:8b-instruct
HLL_TUTOR_IMAGES_ENABLED=false
# Teacher/admin pilot first; enable student access after reviewed accuracy tests.
HLL_TUTOR_STUDENTS_ENABLED=false
# Optional, provider/model-specific. Ollama supports 'none' for concise non-thinking replies.
# Leave blank for an instruct-only endpoint that does not accept this field.
HLL_TUTOR_REASONING_EFFORT=
# Required for a remote HTTPS inference server; never use NEXT_PUBLIC_.
HLL_TUTOR_API_KEY=
