# Copy this file to .env.local and replace the placeholder values.
# The public/publishable key is designed for browser use.
# Never place a Supabase service-role key in this project.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Public signup is disabled unless deliberately enabled for testing.
ENABLE_PUBLIC_SIGNUP=false
# Server-only. Required for trusted writes and school enquiry inserts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
